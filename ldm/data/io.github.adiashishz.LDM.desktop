[Desktop Entry]
Type=Application
Name=LDM
GenericName=Download Manager
Comment=Download files, videos and torrents
Exec=ldm-gui %U
Icon=io.github.adiashishz.LDM
Terminal=false
Categories=Network;FileTransfer;GTK;
Keywords=download;manager;resume;torrent;video;youtube;
StartupNotify=true
DBusActivatable=true
MimeType=x-scheme-handler/magnet;application/x-bittorrent;
